{
  "name": "soberish",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "node scripts/write-config.mjs && ng build",
    "build:pages": "node scripts/write-config.mjs && ng build --base-href \"${BASE_HREF:-/}\" && node scripts/prepare-pages.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "icons": "node scripts/generate-icons.mjs",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"scripts/**/*.mjs\""
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/service-worker": "^22.1.0",
    "@supabase/supabase-js": "^2.112.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "sharp": "^0.35.4",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "description": "Track your blood alcohol content in real time — offline-first Angular PWA.",
  "license": "MIT"
}
